{
  "name": "dg-vue-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs",
    "publish": "npm run pack && npx create-dg@latest --publish",
    "dg:sandbox": "npx create-dg@latest --sandbox"
  },
  "dependencies": {
    "dgclient": "^0.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "fflate": "^0.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.68.0",
    "esbuild": "npm:esbuild-wasm@^0.28.0"
  }
}
